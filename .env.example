# Copy this file to .env and fill in real values locally.
# Do not commit .env or any real credentials.

# Google Gemini API for Lyria music generation.
GEMINI_API_KEY=

# OpenAI API for image generation.
OPENAI_API_KEY=

# YouTube Data API OAuth credentials.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# Optional defaults for future scripts.
YOUTUBE_PRIVACY_STATUS=private
DEFAULT_TRACK_DURATION_SECONDS=180
DEFAULT_BATCH_TRACK_COUNT=10
